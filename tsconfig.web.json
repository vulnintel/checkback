{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "outDir": "dist/web",
    "rootDir": "web/src",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["web/src"]
}
