{
  "name": "checkback",
  "version": "0.1.0",
  "description": "Local security check for apps built with AI coding tools",
  "keywords": [
    "security",
    "secrets",
    "secret-scanning",
    "dependencies",
    "vulnerability",
    "sbom",
    "cyclonedx",
    "supabase",
    "firebase",
    "mcp",
    "mcp-server",
    "claude-code",
    "vibe-coding"
  ],
  "homepage": "https://github.com/vulnintel/checkback#readme",
  "bugs": {
    "url": "https://github.com/vulnintel/checkback/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vulnintel/checkback.git"
  },
  "license": "Apache-2.0",
  "author": "VulnIntel (https://www.vulnintelapp.com)",
  "type": "module",
  "engines": {
    "node": ">=20.18.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "checkback": "./dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "data",
    "web/index.html",
    "web/app.css",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.web.json",
    "test": "vitest run --testTimeout=30000",
    "prepublishOnly": "pnpm build && pnpm test",
    "e2e:docker": "bash docker/e2e/run.sh"
  },
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@cyclonedx/cyclonedx-library": "^10.4.0",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "ajv-formats-draft2019": "^1.6.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
}
